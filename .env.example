# API base URL (use your machine LAN IP on physical devices, not localhost)
API_URL=http://localhost:5001

# Comma-separated Google OAuth client IDs (iOS/Android/Web from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com

# Goong Maptiles key (goong.io dashboard) — for rendering the map, separate from GOONG_API_KEY used server-side
GOONG_MAP_API_KEY=your-goong-maptiles-key

# Meta app for Facebook Login (developers.facebook.com → App settings → Basic / Advanced → Client token)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_CLIENT_TOKEN=your-facebook-client-token
