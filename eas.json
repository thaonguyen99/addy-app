{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "22.17.0",
      "env": {
        "INVITE_LINK_HOST": "addy.io.vn"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.17.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "INVITE_LINK_HOST": "addy.io.vn"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "22.17.0",
      "env": {
        "INVITE_LINK_HOST": "addy.io.vn"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
